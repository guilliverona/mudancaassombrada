# Arquivos binários: o Git nunca deve mexer no conteúdo deles (nem nas quebras de linha)
*.pdf binary
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.blend binary

# Arquivos do Unity (texto YAML/JSON): sempre LF, no repositório e no disco.
# O Unity grava com LF; sem isto, o autocrlf do Windows converte para CRLF e o
# git status marca arquivos "modificados" que não têm mudança nenhuma.
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.meta    text eol=lf
*.asmdef  text eol=lf
*.controller text eol=lf
*.anim    text eol=lf
